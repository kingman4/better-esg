package views

// BaseLayout is the HTML shell used by all pages.
// authenticated: whether to show the nav bar. userEmail: displayed in nav.
// currentPath: for active link highlighting. fdaEnv: "prod" or "test".
templ BaseLayout(title string, authenticated bool, userEmail string, currentPath string, fdaEnv string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full bg-gray-50">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title } — FDA ESG NextGen</title>
		<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet"/>
		<script src="https://unpkg.com/htmx.org@2.0.4"></script>
		<link rel="stylesheet" href="/static/css/app.css"/>
	</head>
	<body class="h-full">
		if authenticated {
			<nav class="bg-white shadow-sm border-b border-gray-200">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="flex justify-between h-16">
						<div class="flex">
							<div class="flex-shrink-0 flex items-center space-x-3">
								<span class="text-xl font-bold text-blue-700">ESG NextGen</span>
								if fdaEnv == "prod" {
									<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-100 text-red-800 border border-red-300 uppercase tracking-wide">PROD</span>
								} else {
									<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-yellow-100 text-yellow-800 border border-yellow-300 uppercase tracking-wide">UAT</span>
								}
							</div>
							<div class="hidden sm:ml-8 sm:flex sm:space-x-4">
								<a href="/dashboard"
									class={ "inline-flex items-center px-3 py-2 text-sm font-medium rounded-md",
										templ.KV("bg-blue-50 text-blue-700", currentPath == "/dashboard"),
										templ.KV("text-gray-600 hover:text-gray-900 hover:bg-gray-50", currentPath != "/dashboard") }>
									Dashboard
								</a>
								<a href="/dashboard/submissions"
									class={ "inline-flex items-center px-3 py-2 text-sm font-medium rounded-md",
										templ.KV("bg-blue-50 text-blue-700", currentPath == "/dashboard/submissions"),
										templ.KV("text-gray-600 hover:text-gray-900 hover:bg-gray-50", currentPath != "/dashboard/submissions") }>
									Submissions
								</a>
							</div>
						</div>
						<div class="flex items-center space-x-4">
							<span class="text-sm text-gray-500">{ userEmail }</span>
							<form method="POST" action="/auth/logout">
								<button type="submit" class="text-sm text-gray-500 hover:text-gray-700">Logout</button>
							</form>
						</div>
					</div>
				</div>
			</nav>
		}
		<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
			{ children... }
		</main>
		<script src="/static/js/app.js"></script>
	</body>
	</html>
}
