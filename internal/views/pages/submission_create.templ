package pages

import (
	"github.com/kingman4/better-esg/internal/views"
	"github.com/kingman4/better-esg/internal/views/components"
)

// CreateSubmissionPage renders the create submission form.
templ CreateSubmissionPage(data CreateSubmissionData) {
	@views.BaseLayout("New Submission", true, data.UserEmail, "/dashboard/submissions", data.Env) {
		<div class="max-w-2xl mx-auto space-y-6">
			<div class="flex items-center space-x-4">
				<a href="/dashboard/submissions" class="text-gray-400 hover:text-gray-600">
					<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
					</svg>
				</a>
				<h1 class="text-2xl font-bold text-gray-900">Create Submission</h1>
			</div>

			@components.FlashError(data.Error)

			<form method="POST" action="/dashboard/submissions" enctype="multipart/form-data" class="bg-white shadow-sm rounded-lg border border-gray-200 p-6 space-y-5">
				<div>
					<label for="name" class="block text-sm font-medium text-gray-700">Submission Name <span class="text-red-500">*</span></label>
					<input id="name" name="name" type="text" required value={ data.Name }
						class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 border"
						placeholder="e.g. Q1 2026 Safety Report"/>
				</div>

				<div>
					<label for="fda_center" class="block text-sm font-medium text-gray-700">FDA Center <span class="text-red-500">*</span></label>
					<select id="fda_center" name="fda_center" required
						class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 border">
						<option value="" disabled selected?={ data.FDACenter == "" }>-- Select a center --</option>
						<option value="CBER" selected?={ data.FDACenter == "CBER" }>CBER — Center for Biologics Evaluation and Research</option>
						<option value="CDER" selected?={ data.FDACenter == "CDER" }>CDER — Center for Drug Evaluation and Research</option>
						<option value="CDRH" selected?={ data.FDACenter == "CDRH" }>CDRH — Center for Devices and Radiological Health</option>
						<option value="HFP" selected?={ data.FDACenter == "HFP" }>HFP — Center for Food Safety and Applied Nutrition</option>
						<option value="CTP" selected?={ data.FDACenter == "CTP" }>CTP — Center for Tobacco Products</option>
						<option value="CVM" selected?={ data.FDACenter == "CVM" }>CVM — Center for Veterinary Medicine</option>
						<option value="OC" selected?={ data.FDACenter == "OC" }>OC — Office of the Commissioner</option>
						<option value="OII" selected?={ data.FDACenter == "OII" }>OII — Office of International Programs</option>
						<option value="OOPD" selected?={ data.FDACenter == "OOPD" }>OOPD — Office of Orphan Products Development</option>
						<option value="OPQ" selected?={ data.FDACenter == "OPQ" }>OPQ — Office of Pharmaceutical Quality</option>
						<option value="Health Canada" selected?={ data.FDACenter == "Health Canada" }>Health Canada</option>
					</select>
				</div>

				<div>
					<label for="submission_type" class="block text-sm font-medium text-gray-700">Submission Type <span class="text-red-500">*</span></label>
					<p id="type-hint" class="mt-1 text-xs text-gray-500">Select a center first to see valid submission types.</p>
					<select id="submission_type" name="submission_type" required
						class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 border">
						<option value="" disabled selected?={ data.Type == "" }>-- Select a type --</option>
						<!-- CBER -->
						<option value="510K" data-centers="CBER" selected?={ data.Type == "510K" }>510K</option>
						<option value="AERS" data-centers="CBER,CDER" selected?={ data.Type == "AERS" }>AERS</option>
						<option value="AERS Attachments" data-centers="CBER,CDER" selected?={ data.Type == "AERS Attachments" }>AERS Attachments</option>
						<option value="AERS_PREMKT_CBER" data-centers="CBER" selected?={ data.Type == "AERS_PREMKT_CBER" }>AERS_PREMKT_CBER</option>
						<option value="EBLA" data-centers="CBER" selected?={ data.Type == "EBLA" }>EBLA — Electronic Biologics License Application</option>
						<option value="eDMF" data-centers="CBER" selected?={ data.Type == "eDMF" }>eDMF — Electronic Drug Master File</option>
						<option value="EIDE" data-centers="CBER" selected?={ data.Type == "EIDE" }>EIDE — Electronic Investigational Device Exemption</option>
						<option value="EIND" data-centers="CBER,CDER" selected?={ data.Type == "EIND" }>EIND — Electronic Investigational New Drug</option>
						<option value="EUA" data-centers="CBER" selected?={ data.Type == "EUA" }>EUA — Emergency Use Authorization</option>
						<option value="Lot_Release_Protocol" data-centers="CBER" selected?={ data.Type == "Lot_Release_Protocol" }>Lot_Release_Protocol</option>
						<option value="NDA" data-centers="CBER" selected?={ data.Type == "NDA" }>NDA — New Drug Application</option>
						<option value="PMA" data-centers="CBER" selected?={ data.Type == "PMA" }>PMA — Premarket Approval</option>
						<option value="Pre_IND" data-centers="CBER" selected?={ data.Type == "Pre_IND" }>Pre_IND — Pre-Investigational New Drug</option>
						<option value="Promotional_Materials" data-centers="CBER" selected?={ data.Type == "Promotional_Materials" }>Promotional_Materials</option>
						<option value="QSUBS" data-centers="CBER" selected?={ data.Type == "QSUBS" }>QSUBS — Q-Submissions</option>
						<option value="SEND_PILOT" data-centers="CBER" selected?={ data.Type == "SEND_PILOT" }>SEND_PILOT</option>
						<option value="SPL_LDD" data-centers="CBER" selected?={ data.Type == "SPL_LDD" }>SPL_LDD — Structured Product Labeling</option>
						<option value="VAERS" data-centers="CBER" selected?={ data.Type == "VAERS" }>VAERS — Vaccine Adverse Event Reporting</option>
						<!-- CDER -->
						<option value="ACA6004_Drug_Samples" data-centers="CDER" selected?={ data.Type == "ACA6004_Drug_Samples" }>ACA6004_Drug_Samples</option>
						<option value="AERS_PREMKT_CDER" data-centers="CDER" selected?={ data.Type == "AERS_PREMKT_CDER" }>AERS_PREMKT_CDER</option>
						<option value="ECTD" data-centers="CDER" selected?={ data.Type == "ECTD" }>ECTD — Electronic Common Technical Document</option>
						<option value="ECTD WAIVED" data-centers="CDER" selected?={ data.Type == "ECTD WAIVED" }>ECTD WAIVED</option>
						<option value="EDMF_TYPEIII" data-centers="CDER" selected?={ data.Type == "EDMF_TYPEIII" }>EDMF_TYPEIII — Electronic Drug Master File Type III</option>
						<option value="FFU-PILOT" data-centers="CDER" selected?={ data.Type == "FFU-PILOT" }>FFU-PILOT</option>
						<option value="GDUFA_Facility_Registration" data-centers="CDER" selected?={ data.Type == "GDUFA_Facility_Registration" }>GDUFA_Facility_Registration</option>
						<option value="PFC" data-centers="CDER" selected?={ data.Type == "PFC" }>PFC</option>
						<option value="POR Large Molecule Documents" data-centers="CDER" selected?={ data.Type == "POR Large Molecule Documents" }>POR Large Molecule Documents</option>
						<option value="Voluntary_Direct_Aes" data-centers="CDER" selected?={ data.Type == "Voluntary_Direct_Aes" }>Voluntary_Direct_Aes</option>
						<!-- CDRH -->
						<option value="Adverse Events" data-centers="CDRH,CTP" selected?={ data.Type == "Adverse Events" }>Adverse Events</option>
						<option value="Electronic_Submissions" data-centers="CDRH" selected?={ data.Type == "Electronic_Submissions" }>Electronic_Submissions</option>
						<option value="GUDID" data-centers="CDRH" selected?={ data.Type == "GUDID" }>GUDID — Global Unique Device Identification Database</option>
						<!-- HFP (formerly CFSAN) -->
						<option value="DSR_Adverse_Events" data-centers="HFP" selected?={ data.Type == "DSR_Adverse_Events" }>DSR_Adverse_Events</option>
						<option value="EON-Payload-Files" data-centers="HFP" selected?={ data.Type == "EON-Payload-Files" }>EON-Payload-Files</option>
						<option value="Food_Pilot_Listing" data-centers="HFP" selected?={ data.Type == "Food_Pilot_Listing" }>Food_Pilot_Listing</option>
						<option value="Form3479" data-centers="HFP" selected?={ data.Type == "Form3479" }>Form3479</option>
						<option value="Form3480" data-centers="HFP" selected?={ data.Type == "Form3480" }>Form3480</option>
						<option value="Form3480A" data-centers="HFP" selected?={ data.Type == "Form3480A" }>Form3480A</option>
						<option value="Form3503" data-centers="HFP" selected?={ data.Type == "Form3503" }>Form3503</option>
						<option value="Form3665" data-centers="HFP" selected?={ data.Type == "Form3665" }>Form3665</option>
						<option value="Form3666" data-centers="HFP" selected?={ data.Type == "Form3666" }>Form3666</option>
						<option value="Form3667" data-centers="HFP" selected?={ data.Type == "Form3667" }>Form3667</option>
						<option value="NDI" data-centers="HFP" selected?={ data.Type == "NDI" }>NDI — New Dietary Ingredient</option>
						<option value="Threshold_of_Regulation" data-centers="HFP" selected?={ data.Type == "Threshold_of_Regulation" }>Threshold_of_Regulation</option>
						<!-- CTP -->
						<option value="Electronic_Submission" data-centers="CTP" selected?={ data.Type == "Electronic_Submission" }>Electronic_Submission</option>
						<!-- CVM -->
						<option value="Adverse_Events_Reports" data-centers="CVM" selected?={ data.Type == "Adverse_Events_Reports" }>Adverse_Events_Reports</option>
						<option value="eSubmitter" data-centers="CVM" selected?={ data.Type == "eSubmitter" }>eSubmitter</option>
						<!-- OC -->
						<option value="SPL" data-centers="OC" selected?={ data.Type == "SPL" }>SPL — Structured Product Labeling</option>
						<option value="OCAC" data-centers="OC" selected?={ data.Type == "OCAC" }>OCAC</option>
						<!-- OII -->
						<option value="Document_Requests" data-centers="OII" selected?={ data.Type == "Document_Requests" }>Document_Requests</option>
						<option value="POR Small Molecule Documents" data-centers="OII,OPQ" selected?={ data.Type == "POR Small Molecule Documents" }>POR Small Molecule Documents</option>
						<!-- OOPD -->
						<option value="HUD_Designation_Requests" data-centers="OOPD" selected?={ data.Type == "HUD_Designation_Requests" }>HUD_Designation_Requests</option>
						<option value="Orphan_drug_Designation_Requests" data-centers="OOPD" selected?={ data.Type == "Orphan_drug_Designation_Requests" }>Orphan_drug_Designation_Requests</option>
						<!-- OPQ -->
						<option value="7044a4_Pharma_Inspection_Records" data-centers="OPQ" selected?={ data.Type == "7044a4_Pharma_Inspection_Records" }>7044a4_Pharma_Inspection_Records</option>
						<!-- Health Canada -->
						<option value="Transaction" data-centers="Health Canada" selected?={ data.Type == "Transaction" }>Transaction</option>
					</select>
				</div>
				<script>
				(function() {
					var centerSelect = document.getElementById('fda_center');
					var typeSelect = document.getElementById('submission_type');
					var hint = document.getElementById('type-hint');

					// Clone all type options on load so we can rebuild the select each time.
					var allOptions = [];
					typeSelect.querySelectorAll('option[data-centers]').forEach(function(opt) {
						allOptions.push({
							value: opt.value,
							text: opt.textContent,
							centers: opt.getAttribute('data-centers').split(',')
						});
					});

					// Keep a reference to the placeholder option.
					var placeholder = typeSelect.querySelector('option[value=""]');

					function filterTypes() {
						var selectedCenter = centerSelect.value;
						var currentValue = typeSelect.value;

						// Remove all type options (keep placeholder).
						while (typeSelect.lastChild !== placeholder) {
							typeSelect.removeChild(typeSelect.lastChild);
						}

						var matched = [];
						allOptions.forEach(function(o) {
							if (!selectedCenter || o.centers.indexOf(selectedCenter) !== -1) {
								var el = document.createElement('option');
								el.value = o.value;
								el.textContent = o.text;
								typeSelect.appendChild(el);
								matched.push(o);
							}
						});

						// Restore previous selection if still valid, otherwise reset.
						var stillValid = matched.some(function(o) { return o.value === currentValue; });
						if (stillValid) {
							typeSelect.value = currentValue;
						} else if (matched.length === 1) {
							typeSelect.value = matched[0].value;
						} else {
							typeSelect.value = '';
						}

						// Update hint text.
						hint.textContent = selectedCenter ? '' : 'Select a center first to see valid submission types.';
					}

					centerSelect.addEventListener('change', filterTypes);
					// Run on page load in case center is pre-selected (e.g. validation error re-render).
					filterTypes();
				})();
				</script>

				<div>
					<label for="description" class="block text-sm font-medium text-gray-700">Description <span class="text-gray-400 text-xs font-normal">(optional)</span></label>
					<textarea id="description" name="description" rows="3"
						class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 border"
						placeholder="Brief description of this submission">{ data.Desc }</textarea>
				</div>

				<div>
					<label for="files" class="block text-sm font-medium text-gray-700">Files <span class="text-red-500">*</span></label>
					<p class="mt-1 text-xs text-gray-500">Select one or more files to include in this submission.</p>
					<input id="files" name="files" type="file" multiple required
						class="mt-2 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100"/>
				</div>

				<div class="flex justify-end space-x-3 pt-4 border-t border-gray-200">
					<a href="/dashboard/submissions"
						class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
						Cancel
					</a>
					<button type="submit"
						class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
						Create Submission
					</button>
				</div>
			</form>
		</div>
	}
}
