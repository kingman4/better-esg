package pages

import (
	"fmt"
	"github.com/kingman4/better-esg/internal/views"
)

// DashboardPage renders the main dashboard.
templ DashboardPage(data DashboardData) {
	@views.BaseLayout("Dashboard", true, data.UserEmail, "/dashboard", data.Env) {
		<div class="space-y-8">
			<div class="flex items-center justify-between">
				<h1 class="text-2xl font-bold text-gray-900">Dashboard</h1>
				<a href="/dashboard/submissions/new"
					class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
					Create Submission
				</a>
			</div>

			<!-- Stat cards -->
			<div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
				@statCard("Total", fmt.Sprintf("%d", data.TotalCount), "bg-gray-100", "text-gray-800")
				@statCard("Draft", fmt.Sprintf("%d", data.StateCounts["INITIALIZED"]), "bg-gray-50", "text-gray-600")
				@statCard("Submitted", fmt.Sprintf("%d", data.StateCounts["SUBMITTED"]+data.StateCounts["PROCESSING"]), "bg-blue-50", "text-blue-700")
				@statCard("Completed", fmt.Sprintf("%d", data.StateCounts["COMPLETED"]), "bg-green-50", "text-green-700")
				@statCard("Failed", fmt.Sprintf("%d", countFailed(data.StateCounts)), "bg-red-50", "text-red-700")
			</div>

			<!-- Recent submissions -->
			<div>
				<div class="flex items-center justify-between mb-4">
					<h2 class="text-lg font-medium text-gray-900">Recent Submissions</h2>
					<a href="/dashboard/submissions" class="text-sm text-blue-600 hover:text-blue-500">View all</a>
				</div>
				if len(data.RecentSubs) == 0 {
					<div class="text-center py-12 bg-white rounded-lg border border-gray-200">
						<p class="text-gray-500">No submissions yet.</p>
						<a href="/dashboard/submissions/new" class="mt-2 inline-block text-sm text-blue-600 hover:text-blue-500">Create your first submission</a>
					</div>
				} else {
					<div class="bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
						<table class="min-w-full divide-y divide-gray-200">
							<thead class="bg-gray-50">
								<tr>
									<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
									<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
									<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
									<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
								</tr>
							</thead>
							<tbody class="bg-white divide-y divide-gray-200">
								for _, sub := range data.RecentSubs {
									<tr class="hover:bg-gray-50">
										<td class="px-6 py-4 whitespace-nowrap">
											<a href={ templ.SafeURL("/dashboard/submissions/" + sub.ID) } class="text-sm font-medium text-blue-600 hover:text-blue-500">{ sub.Name }</a>
										</td>
										<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{ sub.Type }</td>
										<td class="px-6 py-4 whitespace-nowrap">
											@statusBadge(sub.WorkflowState)
										</td>
										<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{ sub.CreatedAt }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	}
}

templ statCard(label, value, bgColor, textColor string) {
	<div class={ "stat-card rounded-lg p-5 border border-gray-200", bgColor }>
		<p class="text-sm font-medium text-gray-500">{ label }</p>
		<p class={ "mt-1 text-3xl font-semibold", textColor }>{ value }</p>
	</div>
}

templ statusBadge(state string) {
	<span class={ "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium", badgeClass(state) }>
		{ workflowDisplayLabel(state) }
	</span>
}
